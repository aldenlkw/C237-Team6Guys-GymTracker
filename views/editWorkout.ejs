<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Workout - Gym Tracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      background-color: #f8f9fa;
      padding: 20px 0;
    }
    .form-container {
      max-width: 500px;
      margin: 50px auto;
      background-color: white;
      padding: 40px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    h1 {
      text-align: center;
      margin-bottom: 30px;
      color: #333;
      font-weight: 700;
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      font-weight: 600;
      color: #555;
      margin-bottom: 8px;
      display: block;
    }
    input, textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ddd;
      border-radius: 5px;
      font-size: 1rem;
      font-family: inherit;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #007bff;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
    }
    .button-group {
      display: flex;
      gap: 10px;
      margin-top: 30px;
    }
    .btn-submit {
      flex: 1;
      background-color: #007bff;
      color: white;
      padding: 12px;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    .btn-submit:hover {
      background-color: #0056b3;
    }
    .btn-cancel {
      flex: 1;
      background-color: #6c757d;
      color: white;
      padding: 12px;
      border: none;
      border-radius: 5px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      transition: background-color 0.3s;
    }
    .btn-cancel:hover {
      background-color: #5a6268;
      text-decoration: none;
      color: white;
    }
  </style>
</head>
<body>
  <div class="form-container">
    <h1>✏️ Edit Workout</h1>
    
    <form method="POST" action="/workouts/edit/<%= workout.workoutId %>">
      <div class="form-group">
        <label for="exercise">Exercise *</label>
        <input type="text" id="exercise" name="exercise" value="<%= workout.exercise %>" required>
      </div>

      <div class="form-group">
        <label for="weight">Weight (lbs) *</label>
        <input type="number" id="weight" name="weight" step="0.5" value="<%= workout.weight %>" required>
      </div>

      <div class="form-group">
        <label for="reps">Reps *</label>
        <input type="number" id="reps" name="reps" value="<%= workout.reps %>" required>
      </div>

      <div class="form-group">
        <label for="sets">Sets *</label>
        <input type="number" id="sets" name="sets" value="<%= workout.sets %>" required>
      </div>

      <div class="form-group">
        <label for="date">Date *</label>
        <input type="date" id="date" name="date" value="<%= workout.date.toISOString().split('T')[0] %>" required>
      </div>

      <div class="button-group">
        <button type="submit" class="btn-submit">Update Workout</button>
        <a href="/workouts" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

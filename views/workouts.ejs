<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Workouts - Gym Tracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      background-color: #f8f9fa;
      padding: 20px 0;
    }
    .container {
      max-width: 900px;
      margin-top: 30px;
    }
    .header-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }
    .header-section h1 {
      color: #333;
      font-weight: 700;
    }
    .btn-add {
      background-color: #28a745;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
      font-weight: 600;
      transition: background-color 0.3s;
    }
    .btn-add:hover {
      background-color: #218838;
      color: white;
      text-decoration: none;
    }
    .table-container {
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }
    table {
      margin-bottom: 0;
    }
    thead {
      background-color: #343a40;
      color: white;
    }
    tbody tr:hover {
      background-color: #f1f1f1;
    }
    tbody td {
      vertical-align: middle;
      padding: 15px;
    }
    .date-cell {
      color: #666;
      font-size: 0.95rem;
    }
    .action-links {
      display: flex;
      gap: 10px;
    }
    .btn-edit {
      background-color: #007bff;
      color: white;
      padding: 8px 14px;
      text-decoration: none;
      border-radius: 4px;
      font-size: 0.9rem;
      transition: background-color 0.3s;
    }
    .btn-edit:hover {
      background-color: #0056b3;
      color: white;
      text-decoration: none;
    }
    .btn-delete {
      background-color: #dc3545;
      color: white;
      padding: 8px 14px;
      text-decoration: none;
      border-radius: 4px;
      font-size: 0.9rem;
      transition: background-color 0.3s;
    }
    .btn-delete:hover {
      background-color: #c82333;
      color: white;
      text-decoration: none;
    }
    .empty-state {
      text-align: center;
      padding: 50px 20px;
      color: #999;
    }
    .empty-state h3 {
      color: #555;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-section">
      <h1>🏋️ My Workouts</h1>
      <a href="/workouts/add" class="btn-add">+ Add Workout</a>
    </div>

    <% if (workouts && workouts.length > 0) { %>
      <div class="table-container">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Date</th>
              <th>Exercise</th>
              <th>Weight (lbs)</th>
              <th>Reps</th>
              <th>Sets</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% workouts.forEach(workout => { %>
              <tr>
                <td class="date-cell"><%= new Date(workout.workoutDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                <td><strong><%= workout.exerciseName %></strong> <small class="text-muted">(<%= workout.muscleGroup %>)</small></td>
                <td><%= workout.weight %></td>
                <td><%= workout.reps %></td>
                <td><%= workout.sets %></td>
                <td>
                  <div class="action-links">
                    <a href="/workouts/edit/<%= workout.workoutId %>" class="btn-edit">Edit</a>
                    <a href="/workouts/delete/<%= workout.workoutId %>" class="btn-delete" onclick="return confirm('Delete this workout?')">Delete</a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="table-container">
        <div class="empty-state">
          <h3>No workouts yet</h3>
          <p>Start tracking your fitness journey by adding your first workout!</p>
          <a href="/workouts/add" class="btn-add" style="display: inline-block; margin-top: 15px;">+ Add Workout</a>
        </div>
      </div>
    <% } %>

    <div style="margin-top: 30px; text-align: center;">
      <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%- include('partials/header') %>

<div class="form-card">
    <h1>Edit Your Post</h1>
    <p class="form-sub">Update your question below.</p>

    <form action="/forum/edit/<%= post.id %>" method="POST">
        <label for="title">Question Title</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" required>

        <label for="category">Category</label>
        <select id="category" name="category" required>
            <option value="Strength" <%= post.category === 'Strength' ? 'selected' : '' %>>Strength</option>
            <option value="Nutrition" <%= post.category === 'Nutrition' ? 'selected' : '' %>>Nutrition</option>
            <option value="Weight Loss" <%= post.category === 'Weight Loss' ? 'selected' : '' %>>Weight Loss</option>
            <option value="Supplements" <%= post.category === 'Supplements' ? 'selected' : '' %>>Supplements</option>
            <option value="Injuries" <%= post.category === 'Injuries' ? 'selected' : '' %>>Injuries</option>
        </select>

        <label for="question">Question</label>
        <textarea id="question" name="question" rows="6" required><%= post.question %></textarea>

        <button type="submit" class="btn-primary">Save Changes</button>
    </form>

    <p class="form-footer"><a href="/forum/post/<%= post.id %>">Cancel</a></p>
</div>

<%- include('partials/footer') %>